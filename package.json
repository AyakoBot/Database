{
  "name": "@ayako/database",
  "version": "1.0.0",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./src/index.js"
    }
  },
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "pnpm build",
    "compile": "swc src -d dist --strip-leading-paths --copy-files",
    "generate": "pnpx prisma@7.8.0 generate",
    "gather": "pnpx tsx generator.ts",
    "format": "pnpx prisma@7.8.0 format",
    "build": "pnpm gather && pnpm generate && pnpm format && pnpm compile",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@prisma/client": "7.8.0",
    "@prisma/client-runtime-utils": "7.8.0",
    "dotenv": "^17.4.2",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "1.15.43",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.0.0",
    "eslint": "^10.5.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.8.4",
    "prisma": "7.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "^25.6.0",
    "pnpm": "^11.6.0"
  }
}
