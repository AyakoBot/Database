generator client {
  provider = "prisma-client-js"
  output   = "../src"

  engineType             = "binaries"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

//#region Models

model FilteredWord {
  keyword    String
  filterType FilterType

  @@id([keyword, filterType])
}

enum FilterType {
  Profanity
  SexualContent
  Slurs
}

model CustomClient {
  guildId   String  @map("guild") @db.VarChar // TODO: rename col once sync fns are obsolete
  appId     String? @map("app") @db.VarChar // TODO: rename col once sync fns are obsolete
  token     String? @db.VarChar
  publicKey String? @db.VarChar
  secret    String? @db.VarChar

  @@id([guildId])
  @@index([appId])
}

model TicketSetting {
  id                  Decimal    @id @map("uniquetimestamp") @db.Decimal
  guild               String     @map("guildid") @db.VarChar
  active              Boolean    @default(false)
  logChannels         String[]   @db.VarChar
  archiveCategory     String?    @db.VarChar
  type                TicketType @default(Thread)
  // Only need on dmToThread & Thread
  archiveDuration     Decimal    @default(60) @db.Decimal
  channel             String?    @db.VarChar
  // Only need on dmToChannel & Channel
  category            String?    @db.VarChar
  // Only need on dmToThread & dmToChannel
  sendMessagePrefixes String[]   @db.Text

  mentionRoles String[] @db.VarChar
  mentionUsers String[] @db.VarChar

  denyUserIds String[]   @map("bluserid") @db.VarChar
  denyRoleIds String[]   @map("blroleid") @db.VarChar
  DMTicket    DMTicket[]

  @@index(guild)
  @@index(type)
}

model DMTicket {
  dmId       String  @id @db.VarChar
  userId     String  @unique @db.VarChar
  channelId  String  @unique @db.VarChar
  settingsId Decimal @db.Decimal

  settings TicketSetting @relation(fields: [settingsId], references: [id])

  @@index(dmId)
  @@index(channelId)
}

enum TicketType {
  dmToThread
  dmToChannel
  Thread
  Channel
}

model AfkState {
  userId  String  @map("user") @db.VarChar // TODO: rename col once sync fns are obsolete
  reason  String?
  since   Decimal @db.Decimal
  guildId String  @map("guild") @db.VarChar // TODO: rename col once sync fns are obsolete

  @@id([userId, guildId])
  @@index([userId, guildId])
}

model AfkSetting {
  guildId    String @map("guild") @db.VarChar // TODO: rename col once sync fns are obsolete
  maxLetters Int    @default(250)

  @@id(guildId)
}

model GuildSetting {
  guildId           String   @map("guild") @db.VarChar // TODO: rename col once sync fns are obsolete
  prefix            String?
  interactionsMode  Boolean  @default(true)
  language          String   @default("en-GB")
  errorChannel      String?  @db.VarChar
  rpEnabled         Boolean  @default(false)
  rpEnableRuns      Decimal  @default(0) @db.Decimal
  lastRpSyncRun     Decimal? @db.Decimal
  ptReminderEnabled Boolean  @default(true)
  legacyRp          Boolean  @default(false)
  editRpCommands    Boolean  @default(true)
  enableInvitesAt   Decimal? @db.Decimal
  statusChannel     String?  @db.VarChar
  updatesChannel    String?
  notifyChannel     String?

  @@id([guildId])
  @@index([guildId])
}

//#endregion
